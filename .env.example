SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the public anon/publishable key; never use a service_role key here.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Optional: add this same URL to Supabase Auth's Redirect URLs.
SUPABASE_AUTH_REDIRECT_TO=https://YOUR_SITE.example/admin.html
# Server-only Resend key for new-order notifications. Never expose this in browser code.
RESEND_API_KEY=YOUR_RESEND_API_KEY
ORDER_NOTIFICATION_EMAIL=greenhub2027@gmail.com
# Use a verified sender domain in production. The default is Resend's test sender.
ORDER_EMAIL_FROM=Greenhub Orders <onboarding@resend.dev>
